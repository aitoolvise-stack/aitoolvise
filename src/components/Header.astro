---
// src/components/Header.astro
import { Image } from 'astro:assets';
import logo from '../assets/Logo-Photoroom.webp';

const navItems = [
  { label: 'Compare', href: '/compare/' },
  { label: 'Reviews', href: '/reviews/' },
  { label: 'Best Tools', href: '/best-tools/' },
  { label: 'How To', href: '/how-to/' },
  { label: 'Blog', href: '/blog/' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="AIToolvise home">
      <Image src={logo} alt="AIToolvise" height={58} />
    </a>

    <!-- Pure-CSS hamburger: checkbox drives menu state, no JS needed -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle menu">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-navy);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .site-header__logo {
    display: flex;
    align-items: center;
  }
  .site-header__logo img {
    display: block;
    height: 58px;
    width: auto;
  }
  .site-header__logo:hover { opacity: 0.85; }

  .site-nav__list {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__list a {
    color: var(--color-text-on-navy);
    font-weight: 500;
    font-size: var(--fs-sm);
  }
  .site-nav__list a:hover {
    color: #ffffff;
    text-decoration: none;
  }

  /* Hide checkbox + label on desktop */
  .nav-toggle { display: none; }
  .nav-toggle-label { display: none; }

  @media (max-width: 768px) {
    .nav-toggle-label {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 32px;
      height: 32px;
      cursor: pointer;
      z-index: 60;
    }

    .nav-toggle-bar {
      display: block;
      width: 100%;
      height: 2px;
      background: #ffffff;
      border-radius: 2px;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    /* Off-canvas nav, collapsed by default on mobile */
    .site-nav {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      background: var(--color-navy);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .site-nav__list {
      flex-direction: column;
      gap: 0;
      padding: var(--space-1) 0;
    }

    .site-nav__list a {
      display: block;
      padding: var(--space-2) var(--space-2);
      border-top: 1px solid var(--color-navy-light);
    }

    /* Checkbox-driven open state — pure CSS, no JS */
    .nav-toggle:checked ~ .site-nav {
      max-height: 400px;
    }

    /* Animate the hamburger into an X when open */
    .nav-toggle:checked ~ .nav-toggle-label .nav-toggle-bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked ~ .nav-toggle-label .nav-toggle-bar:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle:checked ~ .nav-toggle-label .nav-toggle-bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>