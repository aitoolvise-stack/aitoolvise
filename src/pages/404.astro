---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — AIToolvise"
  description="The page you're looking for doesn't exist."
>
  <section class="section container prose" style="text-align: center; padding-block: var(--space-5);">
    <h1>404</h1>
    <p style="font-size: var(--fs-lg); margin-bottom: var(--space-3);">
      This page doesn't exist — it may have been moved or the link might be outdated.
    </p>
    <a href="/" class="btn btn-cta">Back to homepage</a>
  </section>
</BaseLayout>