---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('compare', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="AI Tool Comparisons — AIToolvise" description="Side-by-side comparisons to help you pick the right AI tool.">
  <section class="section container">
    <h1>Compare</h1>
    <p class="intro">Head-to-head comparisons of popular AI tools, so you know exactly which one fits your needs.</p>
    <div class="grid">
      {posts.map((post) => (
        <a href={`/compare/${post.data.slug ?? post.id}`} class="card-rating">
          <Image src={post.data.image.src} alt={post.data.image.alt} class="card-rating__image" width={400} height={225} />
          <h2>{post.data.title}</h2>
          <p class="card-rating__desc">{post.data.description}</p>
          {post.data.rating && <span class="card-rating__score">★ {post.data.rating.toFixed(1)}</span>}
        </a>
      ))}
    </div>
    {posts.length === 0 && <p>No comparisons published yet — check back soon.</p>}
  </section>
</BaseLayout>

<style>
  .intro { color: var(--color-text-muted); max-width: 640px; margin-bottom: var(--space-4); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-3); }
  .card-rating { display: block; color: inherit; }
  .card-rating:hover { text-decoration: none; border-color: var(--color-blue); }
  .card-rating__image { width: 100%; height: 160px; object-fit: cover; border-radius: var(--radius); margin-bottom: var(--space-2); }
  .card-rating h2 { font-size: var(--fs-lg); margin-bottom: var(--space-1); }
  .card-rating__desc { color: var(--color-text-muted); font-size: var(--fs-sm); margin-bottom: var(--space-2); }
</style>