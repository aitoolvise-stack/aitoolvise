---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('bestTools', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Best AI Tools — AIToolvise" description="Curated roundups of the best AI tools for every use case.">
  <section class="section container">
    <h1>Best Tools</h1>
    <p class="intro">Curated lists of the best AI tools, organized by use case.</p>
    <div class="grid">
      {posts.map((post) => (
        <a href={`/best-tools/${post.data.slug ?? post.id}`} class="card-standard">
          <Image src={post.data.image.src} alt={post.data.image.alt} class="card-standard__image" width={400} height={225} />
          <h2>{post.data.title}</h2>
          <p class="card-standard__desc">{post.data.description}</p>
        </a>
      ))}
    </div>
    {posts.length === 0 && <p>No roundups published yet — check back soon.</p>}
  </section>
</BaseLayout>

<style>
  .intro { color: var(--color-text-muted); max-width: 640px; margin-bottom: var(--space-4); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-3); }
  .card-standard { display: block; color: inherit; }
  .card-standard:hover { text-decoration: none; border-color: var(--color-blue); }
  .card-standard__image { width: 100%; height: 160px; object-fit: cover; border-radius: var(--radius); margin-bottom: var(--space-2); }
  .card-standard h2 { font-size: var(--fs-lg); margin-bottom: var(--space-1); }
  .card-standard__desc { color: var(--color-text-muted); font-size: var(--fs-sm); }
</style>
