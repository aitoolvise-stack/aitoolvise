---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews', ({ data }) => !data.draft);
  return reviews.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, rating, toolName, toolUrl, pubDate, updatedDate, faq } = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

const scorePct = rating ? (rating / 5) * 100 : 0;

const formattedDate = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: 'AIToolvise' },
  publisher: { '@type': 'Organization', name: 'AIToolvise' },
};

const reviewSchema = rating && toolName ? {
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: { '@type': 'SoftwareApplication', name: toolName },
  reviewRating: { '@type': 'Rating', ratingValue: rating, bestRating: 5, worstRating: 1 },
  author: { '@type': 'Organization', name: 'AIToolvise' },
  datePublished: pubDate.toISOString(),
} : null;

const faqSchema = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {reviewSchema && <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <article class="review">
    <header class="review__hero container">
      <p class="review__eyebrow">Review</p>
      <h1>{title}</h1>
      <p class="review__meta">
        Published {formattedDate}
        {updatedDate && ` · Updated ${updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}`}
      </p>
    </header>

    {rating && (
      <div class="verdict container">
        <div class="score-ring" style={`--pct: ${scorePct}`}>
          <span class="score-ring__value">{rating.toFixed(1)}</span>
        </div>
        <div class="verdict__text">
          <p class="verdict__label">AIToolvise Score</p>
          <p class="verdict__out-of">out of 5</p>
        </div>
        {toolUrl && (
          <a href={toolUrl} class="btn btn-cta verdict__cta" rel="sponsored noopener" target="_blank">
            Visit {toolName ?? 'Website'} →
          </a>
        )}
      </div>
    )}

    <div class="review__layout container">
      {toc.length > 0 && (
        <aside class="review__toc">
          <p class="review__toc-label">On this page</p>
          <nav>
            <ul>
              {toc.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
      <div class="review__body">
        <Content />
      </div>
    </div>

    {faq && faq.length > 0 && (
      <section class="faq container">
        <h2>Frequently Asked Questions</h2>
        {faq.map((item) => (
          <details class="faq__item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </section>
    )}

    {toolUrl && (
      <div class="review__bottom-cta container">
        <a href={toolUrl} class="btn btn-cta" rel="sponsored noopener" target="_blank">
          Visit {toolName ?? 'Website'} →
        </a>
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .review__hero { padding-block: var(--space-4) var(--space-3); text-align: left; }
  .review__eyebrow { color: var(--color-blue); font-weight: 700; font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-1); }
  .review__meta { color: var(--color-text-muted); font-size: var(--fs-sm); margin: 0; }

  .verdict { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: var(--space-3); margin-block: var(--space-3); }
  .score-ring { --size: 96px; width: var(--size); height: var(--size); flex-shrink: 0; border-radius: 50%; background: conic-gradient(var(--color-green) calc(var(--pct) * 1%), var(--color-border) 0); display: flex; align-items: center; justify-content: center; position: relative; }
  .score-ring::before { content: ''; position: absolute; inset: 7px; background: #ffffff; border-radius: 50%; }
  .score-ring__value { position: relative; font-size: var(--fs-xl); font-weight: 800; color: var(--color-navy); }
  .verdict__text { flex: 1; min-width: 120px; }
  .verdict__label { font-weight: 700; color: var(--color-navy); margin: 0; }
  .verdict__out-of { color: var(--color-text-muted); font-size: var(--fs-sm); margin: 0; }
  .verdict__cta { flex-shrink: 0; }

  /* Two-column layout: TOC + body */
  .review__layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-3);
  }

  .review__toc {
    position: sticky;
    top: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-2);
    font-size: var(--fs-sm);
  }
  .review__toc-label {
    font-weight: 700;
    color: var(--color-navy);
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-1);
  }
  .review__toc ul { list-style: none; padding: 0; margin: 0; }
  .review__toc li { margin-bottom: var(--space-1); }
  .review__toc a { color: var(--color-text-muted); text-decoration: none; }
  .review__toc a:hover { color: var(--color-blue); }

  .review__body { max-width: 760px; line-height: 1.75; }
  .review__body :global(h2) { margin-top: var(--space-4); scroll-margin-top: var(--space-3); }
  .review__body :global(h3) { margin-top: var(--space-3); }
  .review__body :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
    margin-block: var(--space-3);
  }

  /* Table styling */
  .review__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--space-3);
    font-size: var(--fs-sm);
    table-layout: fixed;
  }
  .review__body :global(th) {
    background: var(--color-navy);
    color: #ffffff;
    text-align: left;
    padding: 12px 16px;
    font-weight: 600;
    word-wrap: break-word;
  }
  .review__body :global(td) {
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
    word-wrap: break-word;
    vertical-align: top;
  }
  .review__body :global(tr:nth-child(even)) { background: var(--color-surface); }

  .faq { padding-block: var(--space-4); max-width: 760px; }
  .faq__item { border: 1px solid var(--color-border); border-radius: var(--radius); padding: var(--space-2) var(--space-3); margin-bottom: var(--space-1); }
  .faq__item summary { cursor: pointer; font-weight: 600; color: var(--color-navy); }
  .faq__item p { margin-top: var(--space-2); color: var(--color-text-muted); }

  .review__bottom-cta { padding-block: var(--space-4); text-align: center; }

  @media (max-width: 860px) {
    .review__layout { grid-template-columns: 1fr; }
    .review__toc { position: static; }
  }

  @media (max-width: 640px) {
    .verdict { flex-direction: column; text-align: center; }

    .review__body :global(table) { font-size: 0.75rem; }
    .review__body :global(th),
    .review__body :global(td) { padding: 8px 6px; }
  }
</style>